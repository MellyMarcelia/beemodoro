// TypeScript settings for the screen (src/renderer). Starts from ready-made
// settings and lists which files to check.
{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.vue",
    "src/preload/*.d.ts",
    "src/shared/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    // Lets code write "@renderer/..." as a shortcut for "src/renderer/src/..."
    "paths": {
      "@renderer/*": ["./src/renderer/src/*"]
    }
  }
}
