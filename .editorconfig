# Tells code editors how to format files in this project, so everyone's
# editor behaves the same.
root = true

# For every file:
[*]
# Standard text encoding (so emoji and accents work)
charset = utf-8
# Indent with 2 spaces, not tabs
indent_style = space
indent_size = 2
# Mac/Linux-style line endings
end_of_line = lf
# End every file with an empty line, and remove stray spaces at the end of lines
insert_final_newline = true
trim_trailing_whitespace = true